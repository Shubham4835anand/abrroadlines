# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
# Set to your MongoDB URI (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/abrroadlines

# JWT Authentication
JWT_SECRET=abr_roadlines_secret_jwt_key_ambala_2026_production
JWT_EXPIRES_IN=7d

# Email Configuration (Nodemailer)
# For production use your corporate SMTP or SendGrid/Postmark
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@abrroadlines.com
SMTP_PASS=your_email_app_password_here
EMAIL_FROM="ABR Roadlines Notifications <info@abrroadlines.com>"
ADMIN_NOTIFICATION_EMAIL=info@abrroadlines.com

# Security & Verification (Optional)
RECAPTCHA_SECRET_KEY=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

